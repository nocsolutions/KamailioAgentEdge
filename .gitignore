# Per-host secrets and overrides - ship the .example, never the real file.
etc/kamailio/kamailio-local.cfg

# Tool config - holds DB passwords.
tools/.env

# TLS material must never be committed.
etc/kamailio/tls/
*.pem
*.key

# Python cruft.
tools/__pycache__/
__pycache__/
*.pyc

# Node deps for the test client (npm install ws werift).
test/webrtc-client/node_modules/
test/webrtc-client/package-lock.json

# Editor / swap.
*.swp
*~
