# Configuration for tools/sync_subscribers.py and tools/refresh_trs.py
#
#     cp .env.example .env      # then edit
#     chmod 600 .env            # it holds DB passwords
#
# The real .env is git-ignored. Real environment variables override these.

####### Fleet API #########
CLUSTERS_API=http://zbx.noc.solutions:5000/clusters?trs=true

# Limit the credential sync to specific clusters (comma list). Empty = whole
# fleet, which is what you want in practice.
#
# Do NOT scope this to the cut-over clusters. A station's cluster in VICIdial and
# the agent's `cluster` in cgauth drift apart: on av996, 27 webphone stations
# pointed at the edge while cgauth placed several of those agents on av100/av29.
# Scoped, they had a peer aimed at the edge and no credentials on it - they
# simply could not register. Fleet-wide, every enabled agent is present wherever
# their station happens to live. Agents deleted in cgauth stay excluded either
# way, which is the behaviour you want.
#
# Scoping is still useful for a one-off check; note it also disables pruning.
ONLY_CLUSTERS=

####### cgauth master store (source of credentials, READ-ONLY) #########
# The login service's own SQLite DB - the master that provisions every cluster's
# VICIdial `phones`. One source instead of 115, and it carries active/deleted so
# disabled agents get pruned.
#
# MUST be /root/db/cgauth.db - the file the running app holds open. Confirm with:
#   ls -l /proc/$(pgrep -f 'agentauth/app.js')/fd | grep cgauth
# /opt/agentauth/db/cgauth.db is a 40KB stub frozen since February; syncing from
# it would mirror six-month-old credentials and every agent would fail to
# register with no obvious cause.
CGAUTH_SSH=alexandruc@10.4.100.6
CGAUTH_SSH_PORT=22
# Key for the pull. cron has no ssh-agent, so name it explicitly. Authorize it on
# the login host with a forced command so it can do nothing else:
#   command="sudo -n sqlite3 -readonly -noheader -separator '|' /root/db/cgauth.db",\
#   no-agent-forwarding,no-port-forwarding,no-pty,no-X11-forwarding <pubkey>
CGAUTH_SSH_KEY=/home/alexandruc/.ssh/id_ed25519_cgauth
CGAUTH_DB=/root/db/cgauth.db
# The file is root-owned, so the remote sqlite3 runs under sudo. Set 0 only if
# the sync account can read it directly.
CGAUTH_SUDO=1
# Leave CGAUTH_SSH empty to read a local copy at CGAUTH_DB instead (tests).

####### Kamailio DB (destination, local) #########
KAM_DB_HOST=localhost
KAM_DB_PORT=3306
KAM_DB_USER=kamailio
KAM_DB_PASS=
KAM_DB_NAME=kamailio

####### Auth realm #########
# Must match AUTH_REALM in etc/kamailio/kamailio.py and the edge's digest realm.
AUTH_REALM=avatar.tech

####### trs allowlist #########
# address-table group for the telephony-server IPs. Must match TRS_GROUP in
# etc/kamailio/kamailio.py.
TRS_GROUP=1
